# Madeleine — copy to .env and fill in. The live .env is NEVER committed.

# ── Database ──────────────────────────────────────────────────────────────────
# Local Postgres, dedicated database. Same instance as the rest of the fleet;
# Madeleine only ever touches the `madeleine` DB. pgvector must be available
# (it ships with Postgres 18 here; CREATE EXTENSION runs automatically at boot).
MADELEINE_DATABASE_URL=postgresql://postgres:password@localhost:5432/madeleine

# ── Service ───────────────────────────────────────────────────────────────────
# 8011 claimed for Madeleine 2026-08-17 (see RUNBOOK ports table).
MADELEINE_PORT=8011
# When set, the dashboard (Sprint 7) demands HTTP Basic auth with this password.
DASHBOARD_PASSWORD=

# ── Extractor (facts + salience gate) ─────────────────────────────────────────
# Two doors, same brain (claude-haiku-4-5):
#   anthropic  — direct SDK. Use a DEDICATED Madeleine key from
#                console.anthropic.com so extractor spend is visible per-service.
#   openrouter — same model via OpenRouter; reuses the machine's existing key.
# Door flips by env alone; no code change.
EXTRACTOR_PROVIDER=openrouter
EXTRACTOR_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Embeddings (local, nothing leaves the machine) ───────────────────────────
EMBED_MODEL=BAAI/bge-m3

# ── Deep flavor reader (Phase 5, GATE B) ─────────────────────────────────────
READER_MODEL=Qwen/Qwen3-8B
READER_LAYER=18

# ── Retrieval knobs ──────────────────────────────────────────────────────────
SALIENCE_THRESHOLD=0.55
SPREAD_HOPS=3
# 0.6 measured (S3): decay^3 must clear SPREAD_THRESHOLD or 3-hop chains die
SPREAD_DECAY=0.6
SPREAD_THRESHOLD=0.15
FACT_BUDGET_TOKENS=1200
ASSOC_BUDGET_TOKENS=500
MOOD_WEIGHT=0.5

# ── Nightly consolidation ────────────────────────────────────────────────────
NIGHTLY_HOUR=3
FLAVOR_BATCH=200

# ── Decay ────────────────────────────────────────────────────────────────────
# Per-night multiplier on the strength of episodes not recalled in 7 days.
# 0.995 = half strength after 138 active nights (0.98 was 34).
DECAY_FACTOR=0.995
# Passive decay stops here. Above spread.py's 0.1 conduction floor, so an
# unrecalled memory goes DORMANT — still reachable by a strong direct cue,
# still able to climb back via the +0.1 recall boost — instead of dropping off
# the graph. At >=0.1 the compression and tombstone bands can never be
# entered: forgetting is off. Set below 0.1 to let compression resume.
DECAY_MIN_STRENGTH=0.15
# Decay only on days the scope's agent actually lived — was spoken to, or
# recalled something. Silence is not forgetting. Backfill does not count as
# living (an exchange qualifies on its occurred_at, not its import time).
DECAY_REQUIRE_ACTIVITY=true
DECAY_ACTIVITY_WINDOW_HOURS=24
# Does an agent's solitary heartbeat count as living? Default false: a daily
# cron heartbeat would otherwise mark every scope alive every night and defeat
# the gate entirely — and a heartbeat that only writes gives the strengthening
# side no chance to fire. true = the agent's inner life counts as living.
DECAY_SOLITARY_COUNTS=false

# ── Backfill (Sprint 6) ──────────────────────────────────────────────────────
# Rate cap exists for extractor cost control; dry-run prints spend estimates.
BACKFILL_EXCHANGES_PER_MIN=60
